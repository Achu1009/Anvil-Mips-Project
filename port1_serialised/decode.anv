import "types.anv"

// Decode stage. Also owns the register file (reads for the instruction
// coming from Fetch, and the writeback-driven write from Writeback, both
// happen here).
proc Decode(ep_in: right if_id_ch, ep_out: left id_ex_ch, ep_wb: right wb_id_ch) {
    reg regs: logic[32][32];

    loop {
        let wb_data = recv ep_wb.req >> //from writeback
        let in_data = recv ep_in.req >> //from fetch

        let rw = wb_data.reg_write;
        let dest = wb_data.dest_reg;
        let wr_data = wb_data.write_data;

        let in_instr = in_data.instr;
        let in_pc = in_data.pc;
        let in_addr21 = in_instr & 32'h001FFFFF;

        // --- Decode: combinational, computed once for every instruction ---
        let opcode = in_instr[26+:6];
        let funct  = in_instr[0+:6];

        let rd_val = in_instr[11+:5];
        let rt_val = in_instr[16+:5];
        let rs_val = in_instr[21+:5];

        let is_rtype = opcode == 6'b000000;
        let is_lw    = opcode == 6'b100011;
        let is_sw    = opcode == 6'b101011;
        let is_jz    = opcode == 6'b000010;
        let is_sub   = is_rtype & (funct == 6'b100010);
        // is_sub requires opcode 000000 and is_jz requires opcode 000010 --
        // mutually exclusive by construction, so neither needs to be
        // checked nested inside the other.

        let alu_op      = if is_sub == 1'b1 { 4'd1 } else { 4'd0 };
        let alu_src     = is_lw | is_sw;
        let reg_dst     = is_rtype;
        let mem_read    = is_lw;
        let mem_write   = is_sw;
        let reg_write   = is_rtype | is_lw;
        let mem_to_reg  = is_lw;
        let branch_zero = is_jz;

        // Immediate generator. Present unconditionally, as in a real
        // datapath (LW/SW need it); its value is simply don't-care
        // whenever alu_src = 0, since EX then selects rd2 instead.
        let sign_bit = in_instr[15];
        let imm16_32 = in_instr & 32'h0000FFFF;
        let imm_se   = if sign_bit == 1'b1 { imm16_32 | 32'hFFFF0000 } else { imm16_32 };
        let imm_out  = if is_jz == 1'b1 { in_addr21 } else { imm_se };

        // --- Register-file writeback, only when Writeback is retiring an
        // instruction that actually writes a register this cycle ---
        if rw == 1'b1 {
            set regs[dest] := wr_data >>
            set regs[0] := 32'd0
        } >>

        let out_data = id_ex_t::{
            pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val];
            imm = imm_out; addr21 = in_addr21;
            rs = rs_val; rt = rt_val; rd = rd_val;
            alu_op = alu_op; alu_src = alu_src; reg_dst = reg_dst;
            mem_read = mem_read; mem_write = mem_write; reg_write = reg_write;
            mem_to_reg = mem_to_reg; branch_zero = branch_zero
        } >>
        send ep_out.req(out_data) >>
        recv ep_out.res >>
        send ep_wb.res(1'b1) >>
        send ep_in.res(1'b1) >>
        cycle 1
    }
}
