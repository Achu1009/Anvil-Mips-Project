import "types.anv"

proc Decode(ep_in: right if_id_ch, ep_out: left id_ex_ch, ep_wb: right wb_id_ch) {
    reg regs: logic[32][32];
    
    loop {
        let wb_data = recv ep_wb.req >>
        let in_data = recv ep_in.req >>
        
        let rw = wb_data.reg_write;
        let dest = wb_data.dest_reg;
        let wr_data = wb_data.write_data;
        
        let in_instr = in_data.instr;
        let in_pc = in_data.pc;
        let in_addr21 = in_instr & 32'h001FFFFF;
        
        if rw == 1'b1 {
            set regs[dest] := wr_data >>
            set regs[0] := 32'd0 >>
            
            let opcode = in_instr[26+:6];
            let funct = in_instr[0+:6];
            
            let rd_val = in_instr[11+:5];
            let rt_val = in_instr[16+:5];
            let rs_val = in_instr[21+:5];
            
            let is_rtype = opcode == 6'b000000;
            let is_lw    = opcode == 6'b100011;
            let is_sw    = opcode == 6'b101011;
            let is_jz    = opcode == 6'b000010;            
            let is_sub = is_rtype & (funct == 6'b100010);
            if is_sub == 1'b1 {
                let alu_op = 4'd1;
                let sign_bit = in_instr[15];
                let imm16_32 = in_instr & 32'h0000FFFF;
                if is_jz == 1'b1 {
                    let imm_out = in_instr & 32'h001FFFFF;
                    let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                    send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                } else {
                    if sign_bit == 1'b1 {
                        let imm_out = imm16_32 | 32'hFFFF0000;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    } else {
                        let imm_out = imm16_32;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    }
                }
            } else {
                let alu_op = 4'd0;
                let sign_bit = in_instr[15];
                let imm16_32 = in_instr & 32'h0000FFFF;
                if is_jz == 1'b1 {
                    let imm_out = in_instr & 32'h001FFFFF;
                    let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                    send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                } else {
                    if sign_bit == 1'b1 {
                        let imm_out = imm16_32 | 32'hFFFF0000;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    } else {
                        let imm_out = imm16_32;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    }
                }
            }
        } else {
            let opcode = in_instr[26+:6];
            let funct = in_instr[0+:6];
            
            let rd_val = in_instr[11+:5];
            let rt_val = in_instr[16+:5];
            let rs_val = in_instr[21+:5];
            
            let is_rtype = opcode == 6'b000000;
            let is_lw    = opcode == 6'b100011;
            let is_sw    = opcode == 6'b101011;
            let is_jz    = opcode == 6'b000010;            
            let is_sub = is_rtype & (funct == 6'b100010);
            if is_sub == 1'b1 {
                let alu_op = 4'd1;
                let sign_bit = in_instr[15];
                let imm16_32 = in_instr & 32'h0000FFFF;
                if is_jz == 1'b1 {
                    let imm_out = in_instr & 32'h001FFFFF;
                    let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                    send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                } else {
                    if sign_bit == 1'b1 {
                        let imm_out = imm16_32 | 32'hFFFF0000;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    } else {
                        let imm_out = imm16_32;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    }
                }
            } else {
                let alu_op = 4'd0;
                let sign_bit = in_instr[15];
                let imm16_32 = in_instr & 32'h0000FFFF;
                if is_jz == 1'b1 {
                    let imm_out = in_instr & 32'h001FFFFF;
                    let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                    send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                } else {
                    if sign_bit == 1'b1 {
                        let imm_out = imm16_32 | 32'hFFFF0000;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    } else {
                        let imm_out = imm16_32;
                        let out_data = id_ex_t::{pc = in_pc; rd1 = *regs[rs_val]; rd2 = *regs[rt_val]; imm = imm_out; addr21 = in_addr21; rs = rs_val; rt = rt_val; rd = rd_val; alu_op = alu_op; alu_src = is_lw | is_sw; reg_dst = is_rtype; mem_read = is_lw; mem_write = is_sw; reg_write = is_rtype | is_lw; mem_to_reg = is_lw; branch_zero = is_jz} >>
                        send ep_out.req(out_data) >> recv ep_out.res >> send ep_wb.res(1'b1) >> send ep_in.res(1'b1) >> cycle 1
                    }
                }
            }
        }
    }
}
