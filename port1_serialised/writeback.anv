import "types.anv"

// Writeback stage. prev_*/temp_* follow the same latch pattern as in
// Execute: prev_* is sent back to Decode as this cycle's writeback,
// temp_* is this cycle's freshly computed result, committed to prev_*
// only once the handshakes with Memory and Decode have completed.
proc Writeback(ep_in: right mem_wb_ch, ep_wb_out: left wb_id_ch) {
    reg prev_write_data : logic[32];
    reg prev_dest_reg : logic[5];
    reg prev_reg_write : logic;

    reg temp_write_data : logic[32];
    reg temp_dest_reg : logic[5];
    reg temp_reg_write : logic;

    loop {
        let out_data = wb_update_t::{
            write_data = *prev_write_data;
            dest_reg = *prev_dest_reg;
            reg_write = *prev_reg_write
        } >>
        send ep_wb_out.req(out_data) >>

        let in_data = recv ep_in.req >>

        let mtr = in_data.mem_to_reg;
        let mem_d = in_data.mem_data;
        let alu_res = in_data.alu_result;
        let in_dest_reg = in_data.dest_reg;
        let in_reg_write = in_data.reg_write;

        // Mux: LW writes back the loaded memory word; everything else that
        // writes back at all writes back the ALU result.
        let wr_val = if mtr == 1'b1 { mem_d } else { alu_res };

        set temp_write_data := wr_val >>
        set temp_dest_reg := in_dest_reg >>
        set temp_reg_write := in_reg_write >>

        send ep_in.res(1'b1) >>
        recv ep_wb_out.res >>

        set prev_write_data := *temp_write_data >>
        set prev_dest_reg := *temp_dest_reg >>
        set prev_reg_write := *temp_reg_write >>
        cycle 1
    }
}
