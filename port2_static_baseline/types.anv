// ============================================================
//  types.anv  -- 1-IPC pipelined MIPS, Anvil HDL
//  All inter-stage channels are ONE-WAY with static timing
//  contracts (@#1 - @#1): no req/res handshake, no valid or
//  ack wires, no blocking. See report section "Contracts".
// ============================================================

struct if_id_t {
    pc     : logic[32],
    instr  : logic[32],
    valid  : logic
}

struct id_ex_t {
    rd1         : logic[32],
    rd2         : logic[32],
    imm         : logic[32],
    addr21      : logic[32],
    rs          : logic[5],
    rt          : logic[5],
    rd          : logic[5],
    alu_sub     : logic,
    alu_src     : logic,
    reg_dst     : logic,
    mem_read    : logic,
    mem_write   : logic,
    reg_write   : logic,
    mem_to_reg  : logic,
    branch_zero : logic,
    valid       : logic
}

struct ex_mem_t {
    alu_result : logic[32],
    write_data : logic[32],
    dest_reg   : logic[5],
    mem_read   : logic,
    mem_write  : logic,
    reg_write  : logic,
    mem_to_reg : logic
}

struct mem_wb_t {
    alu_result : logic[32],
    mem_data   : logic[32],
    dest_reg   : logic[5],
    reg_write  : logic,
    mem_to_reg : logic
}

struct wb_update_t {
    write_data : logic[32],
    dest_reg   : logic[5],
    reg_write  : logic
}

struct branch_update_t {
    branch_taken  : logic,
    branch_target : logic[32]
}

// ---- one-way, statically scheduled, handshake-free ----
chan if_id_ch  { right req : (if_id_t         @#1) @#1 - @#1 }
chan id_ex_ch  { right req : (id_ex_t         @#1) @#1 - @#1 }
chan ex_mem_ch { right req : (ex_mem_t        @#1) @#1 - @#1 }
chan mem_wb_ch { right req : (mem_wb_t        @#1) @#1 - @#1 }
chan wb_ch     { right req : (wb_update_t     @#1) @#1 - @#1 }
chan branch_ch { right req : (branch_update_t @#1) @#1 - @#1 }
chan stall_ch  { right req : (logic           @#1) @#1 - @#1 }
